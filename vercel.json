{
  "rewrites": [
    { "source": "/:path*", "destination": "/api/index?__p=:path*" }
  ],
  "functions": {
    "api/index.js": { "includeFiles": "{data,site,manage}/**" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
