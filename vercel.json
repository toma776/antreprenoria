{
  "buildCommand": "echo \"Pe Vercel nu se reconstruiește creierul: data/entitati.json vine din git (npm run sync local).\"",
  "functions": {
    "server.js": {
      "includeFiles": "{data,site,manage}/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "images": {
    "sizes": [
      128,
      256,
      384,
      640
    ],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "antreprenoria.ro",
        "pathname": "^/images/.*$"
      }
    ],
    "minimumCacheTTL": 2678400,
    "formats": [
      "image/webp"
    ],
    "qualities": [
      75
    ]
  }
}
